<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. Everything not listed is backed up as before
     (the library database and settings). -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Belong to a process that no longer exists after a restore. -->
        <exclude domain="root" path="app_flutter/download.lock" />
        <exclude domain="root" path="app_flutter/auto_update_attempts.json" />
        <!-- Downloaded app updates, tens of MB each. Above the 25 MB backup
             quota Android skips the whole backup. -->
        <exclude domain="external" path="Download/updates/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_flutter/download.lock" />
        <exclude domain="root" path="app_flutter/auto_update_attempts.json" />
        <exclude domain="external" path="Download/updates/" />
    </device-transfer>
</data-extraction-rules>
